// nextflow-run/nextflow.config

docker.enabled = true

// Azure Blob Storage credentials, used whenever a param below is passed as
// an az://<container>/<path> URL instead of a local file path (e.g. once
// reference files move to the genomicsngs storage account). Never hardcode
// the actual key here -- same pattern as .env.test/.env.prod: pull it from
// an environment variable.
azure {
    storage {
        accountName = 'genomicsngs'
        accountKey  = System.getenv('AZURE_STORAGE_KEY')
    }
}

params {
    // Required: paired-end fastq files named <sample>_R1_001.fastq.gz /
    // <sample>_R2_001.fastq.gz, same convention as the original script.
    fastq_dir      = null
    outdir         = 'results'

    // Required: reference files (same set the bash pipeline used)
    genome         = null   // hg38_chr1-22-x-y-nc_012920.1.fasta (index files *.amb/*.ann/*.bwt/*.pac/*.sa/*.fai must sit alongside it)
    genome_dict    = null   // hg38_chr1-22-x-y-nc_012920.1.dict
    gene_bed       = null   // medex_illumina_geneboundaries_coding_padded10bp_hg38_sorted.bed -- targets for abra2 / gatk / varscan
    gene_panel_bed = null   // EPLCOM_illumina_geneboundaries_txn_hg38.bed -- samtools subset region for IGV viewing

    // Not yet wired in -- see the note at the bottom of main.nf. Needed
    // once the actual scripts are available.
    varscanmm_script    = null
    post_process_script = null
    config_file          = null
}

process {
    withName: FASTP               { container = 'quay.io/biocontainers/fastp:0.19.6--h8b12597_1';    cpus = 16 }
    withName: BWA_MEM             { container = 'quay.io/biocontainers/bwa:0.7.17--h5bf99c6_8';       cpus = 16 }
    withName: PICARD_SORT_INITIAL { container = 'quay.io/biocontainers/picard:2.18.27--0';             cpus = 4;  memory = '16 GB' }
    withName: ABRA2                { container = 'quay.io/biocontainers/abra2:2.23--h9f5acd7_1';       cpus = 16; memory = '16 GB' }
    withName: PICARD_SORT_ABRA    { container = 'quay.io/biocontainers/picard:2.18.27--0';             cpus = 4;  memory = '16 GB' }
    withName: MARK_DUPLICATES     { container = 'quay.io/biocontainers/picard:2.18.27--0';             cpus = 4;  memory = '16 GB' }
    withName: PICARD_SORT_DEDUP   { container = 'quay.io/biocontainers/picard:2.18.27--0';             cpus = 4;  memory = '16 GB' }
    withName: SUBSET_BAM          { container = 'quay.io/biocontainers/samtools:1.9--h91753b0_8';      cpus = 2 }
    withName: HAPLOTYPECALLER     { container = 'broadinstitute/gatk:4.1.4.1';                          cpus = 16; memory = '16 GB' }
    withName: SAMTOOLS_MPILEUP    { container = 'quay.io/biocontainers/samtools:1.9--h91753b0_8';      cpus = 2 }
    withName: VARSCAN_CALL        { container = 'quay.io/biocontainers/varscan:2.4.3--0';               cpus = 4 }
}
